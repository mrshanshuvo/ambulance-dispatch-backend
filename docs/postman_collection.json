              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"patient@example.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+8801712345678\",\n  \"address\": \"Dhanmondi, Dhaka\"\n}"
