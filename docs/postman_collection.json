    {
      "name": "09. Payment Module",
      "item": [
        {
          "name": "Create Checkout Session (PATIENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.sessionId) {",
                  "        pm.environment.set('paymentSessionId', jsonData.data.sessionId);",
                  "        console.log('Checkout URL:', jsonData.data.checkoutUrl);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"amount\": 1500,\n  \"currency\": \"bdt\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "checkout"]
            },
            "description": "Creates a Stripe Checkout session for an emergency request. The response contains a `checkoutUrl` — open it in the browser to complete payment. Use Stripe test card: 4242 4242 4242 4242, any future date, any CVV."
          }
        },
        {
          "name": "Get Payment Status (PATIENT / ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{requestId}}"]
            },
            "description": "Returns the Payment record for a given emergency request. Status will be PENDING, SUCCESS, FAILED, or REFUNDED."
          }
        },
        {
          "name": "Stripe Webhook (Simulate — for local dev)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "{{stripeWebhookSignature}}", "description": "Generated by Stripe CLI: stripe listen --forward-to localhost:5000/api/v1/payments/webhook" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "webhook"]
            },
            "description": "This endpoint is called by Stripe when payment events occur. Test locally using:\n```\nstripe listen --forward-to localhost:5000/api/v1/payments/webhook\n```\nTrigger test events with:\n```\nstripe trigger checkout.session.completed\n```"
          }
        }
      ]
    }
