    {
      "name": "09. Payment Module",
      "item": [
        {
          "name": "09.1 Common / Status",
          "item": [
            {
              "name": "Get Payment Status (PATIENT / ADMIN)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/{{requestId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "{{requestId}}"]
                },
                "description": "Returns the Payment record for a given emergency request. Status will be PENDING, SUCCESS, FAILED, or REFUNDED across any gateway."
              }
            }
          ]
        },
        {
          "name": "09.2 Stripe Gateway",
          "item": [
            {
              "name": "Create Stripe Checkout Session (PATIENT)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.data && jsonData.data.sessionId) {",
                      "        pm.environment.set('paymentSessionId', jsonData.data.sessionId);",
                      "        console.log('Stripe Checkout URL:', jsonData.data.checkoutUrl);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"amount\": 1500,\n  \"currency\": \"bdt\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/stripe/checkout",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "stripe", "checkout"]
                },
                "description": "Creates a Stripe Checkout session for an emergency request. The response contains a `checkoutUrl` — open it in the browser to complete payment. Use Stripe test card: 4242 4242 4242 4242, any future date, any CVV."
              }
            },
            {
              "name": "Stripe Webhook (Simulate — for local dev)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "stripe-signature", "value": "{{stripeWebhookSignature}}", "description": "Generated by Stripe CLI: stripe listen --forward-to localhost:5000/api/v1/payments/stripe/webhook" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"type\": \"checkout.session.completed\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/stripe/webhook",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "stripe", "webhook"]
                },
                "description": "This endpoint is called by Stripe when payment events occur. Test locally using:\n```\nstripe listen --forward-to localhost:5000/api/v1/payments/stripe/webhook\n```\nTrigger test events with:\n```\nstripe trigger checkout.session.completed\n```"
              }
            }
          ]
        },
        {
          "name": "09.3 bKash PGW (Tokenized)",
          "item": [
            {
              "name": "Create bKash Checkout URL (PATIENT)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.data && jsonData.data.paymentID) {",
                      "        pm.environment.set('bkashPaymentID', jsonData.data.paymentID);",
                      "        console.log('bKash Checkout URL:', jsonData.data.bkashURL);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"amount\": 1500,\n  \"payerReference\": \"01770618575\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/bkash/create",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "bkash", "create"]
                },
                "description": "Creates a bKash Tokenized Checkout payment. Response returns `bkashURL` to redirect the user to bKash Sandbox PGW interface.\n\nTest Wallet: `01770618575` | OTP: `123456` | PIN: `12121`"
              }
            },
            {
              "name": "Execute bKash Payment (PATIENT)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"paymentID\": \"{{bkashPaymentID}}\",\n  \"requestId\": \"{{requestId}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/bkash/execute",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "bkash", "execute"]
                },
                "description": "Executes/Captures the bKash payment once OTP/PIN is confirmed, returning the transaction ID (`trxID`) and marking the request COMPLETED."
              }
            }
          ]
        },
        {
          "name": "09.4 SSLCommerz Gateway",
          "item": [
            {
              "name": "Initiate SSLCommerz Session (PATIENT)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.data && jsonData.data.gatewayPageURL) {",
                      "        console.log('SSLCommerz Gateway URL:', jsonData.data.gatewayPageURL);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"amount\": 2500\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/sslcommerz/initiate",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "sslcommerz", "initiate"]
                },
                "description": "Initializes an SSLCommerz hosted checkout session. Returns `gatewayPageURL` which the patient opens to pay via Cards, Mobile Banking (bKash/Nagad/Rocket), or Net Banking."
              }
            },
            {
              "name": "SSLCommerz Success Callback (Simulate)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"val_id\": \"VALIDATION_MOCK_123456\",\n  \"status\": \"VALID\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/sslcommerz/success?requestId={{requestId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "sslcommerz", "success"],
                  "query": [
                    { "key": "requestId", "value": "{{requestId}}" }
                  ]
                },
                "description": "Simulates browser return after successful SSLCommerz payment. Server validates the transaction via SSLCommerz Validation API and marks request COMPLETED."
              }
            },
            {
              "name": "SSLCommerz IPN Notification (Webhook)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"val_id\": \"VALIDATION_MOCK_123456\",\n  \"tran_id\": \"SSL_TXN_MOCK\",\n  \"status\": \"VALID\",\n  \"value_a\": \"{{requestId}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/payments/sslcommerz/ipn",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "payments", "sslcommerz", "ipn"]
                },
                "description": "Background Instant Payment Notification sent by SSLCommerz server to verify and finalize transactions asynchronously."
              }
            }
          ]
        }
      ]
    }
  ],
