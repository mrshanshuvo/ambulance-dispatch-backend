# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DOCS_URL=https://github.com/mrshanshuvo/ambulance-dispatch-backend#readme

# PostgreSQL Database (Neon.tech / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/ambulance_db?sslmode=require

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_token_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth 2.0 (GCP Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary File/Image Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Cache (Upstash)
REDIS_URL=
REDIS_TOKEN=
