{
  "name": "ambulance-dispatch-backend",
  "version": "1.0.0",
  "description": "Emergency Ambulance Dispatch System Backend API (Express.js, TypeScript, PostgreSQL, Prisma)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "biome check src/"
  },
  "prisma": {
    "seed": "tsx src/prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrshanshuvo/ambulance-dispatch-backend.git"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "emergency-dispatch"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
